# Copy to `.env.local` and adjust. `.env` already carries the shared staging
# default, so this file is only a reminder of what the app reads.

# Socket.IO / WebSocket origin of the player backend.
# Must NOT end with a path — socket.io-client appends `path: '/socket.io'`.
VITE_WS_URL=

# REST base for the player API, including the `/api` path but no trailing slash.
# The backend allow-lists request origins, so the app has to be *served* from an
# allow-listed origin for these calls to work at all — see documentation.md §14.
VITE_API_URL=
